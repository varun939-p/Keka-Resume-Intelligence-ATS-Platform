# Copy to .env and fill in what you have. Everything is optional:
# without keys the app scores with the deterministic engine and logs locally.

KEKA_ENV=POC

# Hybrid LLM scoring (half of each dimension score + the written recommendation).
GROQ_API_KEY=
OPENAI_API_KEY=
# deterministic | groq | openai  (falls back to deterministic when the key is missing)
DEFAULT_LLM_PROVIDER=groq
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Google Sheets mirror. Create a service account, download its JSON key next to
# main.py, and share the spreadsheet with the service account's email (Editor).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Optional: where candidates, batches, the audit log and uploads are stored.
# Defaults to ./data locally and /tmp/keka on Vercel.
# KEKA_DATA_DIR=
